{
  "$defs": {
    "ArchitectureArea": {
      "description": "The 14 architecture areas named by the challenge.",
      "enum": [
        "user_facing_applications",
        "backend_services",
        "apis",
        "databases_and_storage",
        "identity_and_access_management",
        "messaging_and_event_processing",
        "integration_components",
        "ai_and_ml_services",
        "observability_and_monitoring",
        "security_controls",
        "deployment_and_runtime",
        "environments_dev_test_prod",
        "availability_and_scalability",
        "backup_and_disaster_recovery"
      ],
      "title": "ArchitectureArea",
      "type": "string"
    },
    "ArchitectureComponent": {
      "additionalProperties": false,
      "properties": {
        "req_ids": {
          "description": "Scope item ids this element is grounded in.",
          "items": {
            "type": "string"
          },
          "title": "Req Ids",
          "type": "array"
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "description": "customer, inferred, assumed or recommended."
        },
        "validation_required": {
          "default": false,
          "description": "True when a human must validate this element before use.",
          "title": "Validation Required",
          "type": "boolean"
        },
        "validation_reason": {
          "default": "",
          "description": "Why human validation is required, when it is.",
          "title": "Validation Reason",
          "type": "string"
        },
        "id": {
          "description": "Component id such as ARC_01.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Logical component name, platform neutral.",
          "title": "Name",
          "type": "string"
        },
        "area": {
          "$ref": "#/$defs/ArchitectureArea",
          "description": "One of the 14 architecture areas."
        },
        "cloud_service": {
          "description": "Service from the selected platform's catalog.",
          "title": "Cloud Service",
          "type": "string"
        },
        "purpose": {
          "description": "What the component does in the solution.",
          "title": "Purpose",
          "type": "string"
        },
        "supported_ids": {
          "description": "Requirement or assumption ids that justify the component; at least one.",
          "items": {
            "type": "string"
          },
          "title": "Supported Ids",
          "type": "array"
        },
        "rationale": {
          "description": "Why this service was selected.",
          "title": "Rationale",
          "type": "string"
        },
        "trade_offs": {
          "description": "Important trade-offs.",
          "items": {
            "type": "string"
          },
          "title": "Trade Offs",
          "type": "array"
        },
        "dependencies": {
          "description": "Other ARC ids this component depends on.",
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "security_considerations": {
          "default": "",
          "description": "Security considerations for the component.",
          "title": "Security Considerations",
          "type": "string"
        },
        "environments": {
          "description": "Environments the component runs in.",
          "items": {
            "type": "string"
          },
          "title": "Environments",
          "type": "array"
        }
      },
      "required": [
        "basis",
        "id",
        "name",
        "area",
        "cloud_service",
        "purpose",
        "supported_ids",
        "rationale"
      ],
      "title": "ArchitectureComponent",
      "type": "object"
    },
    "Basis": {
      "enum": [
        "customer",
        "inferred",
        "assumed",
        "recommended"
      ],
      "title": "Basis",
      "type": "string"
    },
    "CloudPlatform": {
      "enum": [
        "aws",
        "azure",
        "gcp"
      ],
      "title": "CloudPlatform",
      "type": "string"
    },
    "Environments": {
      "additionalProperties": false,
      "properties": {
        "dev": {
          "description": "Development environment approach.",
          "title": "Dev",
          "type": "string"
        },
        "test": {
          "description": "Test environment approach.",
          "title": "Test",
          "type": "string"
        },
        "prod": {
          "description": "Production environment approach.",
          "title": "Prod",
          "type": "string"
        }
      },
      "required": [
        "dev",
        "test",
        "prod"
      ],
      "title": "Environments",
      "type": "object"
    },
    "Flow": {
      "additionalProperties": false,
      "properties": {
        "from_id": {
          "description": "Id or name of the source component or system.",
          "title": "From Id",
          "type": "string"
        },
        "to_id": {
          "description": "Id or name of the target component or system.",
          "title": "To Id",
          "type": "string"
        },
        "label": {
          "description": "What moves between them.",
          "title": "Label",
          "type": "string"
        },
        "protocol": {
          "default": "",
          "description": "Protocol or mechanism, for example HTTPS REST.",
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "from_id",
        "to_id",
        "label"
      ],
      "title": "Flow",
      "type": "object"
    },
    "NarrativeSection": {
      "additionalProperties": false,
      "description": "A prose section that also points at architecture components.",
      "properties": {
        "req_ids": {
          "description": "Scope item ids this element is grounded in.",
          "items": {
            "type": "string"
          },
          "title": "Req Ids",
          "type": "array"
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "description": "customer, inferred, assumed or recommended."
        },
        "validation_required": {
          "default": false,
          "description": "True when a human must validate this element before use.",
          "title": "Validation Required",
          "type": "boolean"
        },
        "validation_reason": {
          "default": "",
          "description": "Why human validation is required, when it is.",
          "title": "Validation Reason",
          "type": "string"
        },
        "text": {
          "description": "Section content.",
          "title": "Text",
          "type": "string"
        },
        "arc_ids": {
          "description": "Architecture component ids referenced by the section.",
          "items": {
            "type": "string"
          },
          "title": "Arc Ids",
          "type": "array"
        }
      },
      "required": [
        "basis",
        "text"
      ],
      "title": "NarrativeSection",
      "type": "object"
    },
    "PlatformAlternative": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "$ref": "#/$defs/CloudPlatform",
          "description": "Alternative cloud platform."
        },
        "why_not": {
          "description": "Why it was not recommended.",
          "title": "Why Not",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "why_not"
      ],
      "title": "PlatformAlternative",
      "type": "object"
    },
    "PlatformRecommendation": {
      "additionalProperties": false,
      "properties": {
        "req_ids": {
          "description": "Scope item ids this element is grounded in.",
          "items": {
            "type": "string"
          },
          "title": "Req Ids",
          "type": "array"
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "description": "customer, inferred, assumed or recommended."
        },
        "validation_required": {
          "default": false,
          "description": "True when a human must validate this element before use.",
          "title": "Validation Required",
          "type": "boolean"
        },
        "validation_reason": {
          "default": "",
          "description": "Why human validation is required, when it is.",
          "title": "Validation Reason",
          "type": "string"
        },
        "recommended": {
          "$ref": "#/$defs/CloudPlatform",
          "description": "Recommended cloud platform."
        },
        "rationale": {
          "description": "Why this platform fits the requirements.",
          "title": "Rationale",
          "type": "string"
        },
        "alternatives": {
          "description": "Platforms considered and rejected.",
          "items": {
            "$ref": "#/$defs/PlatformAlternative"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "basis",
        "recommended",
        "rationale"
      ],
      "title": "PlatformRecommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "platform": {
      "$ref": "#/$defs/CloudPlatform",
      "description": "Platform the architecture targets."
    },
    "platform_recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlatformRecommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Present when the platform was recommended, not selected."
    },
    "components": {
      "description": "Architecture components grouped by area.",
      "items": {
        "$ref": "#/$defs/ArchitectureComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "flows": {
      "description": "Flows between components.",
      "items": {
        "$ref": "#/$defs/Flow"
      },
      "title": "Flows",
      "type": "array"
    },
    "environments": {
      "$ref": "#/$defs/Environments",
      "description": "Dev, test and production environments."
    },
    "deployment_runtime": {
      "$ref": "#/$defs/NarrativeSection",
      "description": "Deployment and runtime approach."
    },
    "availability_scalability": {
      "$ref": "#/$defs/NarrativeSection",
      "description": "Availability and scalability."
    },
    "backup_dr": {
      "$ref": "#/$defs/NarrativeSection",
      "description": "Backup and disaster recovery."
    },
    "observability": {
      "$ref": "#/$defs/NarrativeSection",
      "description": "Observability and monitoring."
    },
    "security_controls": {
      "$ref": "#/$defs/NarrativeSection",
      "description": "Security controls."
    }
  },
  "required": [
    "platform",
    "environments",
    "deployment_runtime",
    "availability_scalability",
    "backup_dr",
    "observability",
    "security_controls"
  ],
  "title": "Architecture",
  "type": "object"
}
