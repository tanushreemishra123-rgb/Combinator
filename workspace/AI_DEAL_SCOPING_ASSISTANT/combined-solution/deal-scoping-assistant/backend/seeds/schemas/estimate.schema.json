{
  "$defs": {
    "BlockedLine": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "The line that cannot be calculated.",
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "description": "Why it is blocked, e.g. no rate for Data Engineer.",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "reason"
      ],
      "title": "BlockedLine",
      "type": "object"
    },
    "Complexity": {
      "enum": [
        "low",
        "medium",
        "high",
        "very_high"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Milestone name.",
          "title": "Name",
          "type": "string"
        },
        "phase": {
          "description": "Phase the milestone closes.",
          "title": "Phase",
          "type": "string"
        },
        "week_low": {
          "description": "Earliest week the milestone is reached.",
          "minimum": 0,
          "title": "Week Low",
          "type": "number"
        },
        "week_high": {
          "description": "Latest week the milestone is reached.",
          "minimum": 0,
          "title": "Week High",
          "type": "number"
        }
      },
      "required": [
        "name",
        "phase",
        "week_low",
        "week_high"
      ],
      "title": "Milestone",
      "type": "object"
    },
    "MissingInput": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Missing input, e.g. expected_users.",
          "title": "Key",
          "type": "string"
        },
        "impact": {
          "description": "Effect on the estimate.",
          "title": "Impact",
          "type": "string"
        },
        "affected_components": {
          "description": "Estimate components affected by the gap.",
          "items": {
            "type": "string"
          },
          "title": "Affected Components",
          "type": "array"
        }
      },
      "required": [
        "key",
        "impact"
      ],
      "title": "MissingInput",
      "type": "object"
    },
    "PhaseEstimate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Phase name.",
          "title": "Name",
          "type": "string"
        },
        "workstream_ids": {
          "description": "Workstreams in the phase.",
          "items": {
            "type": "string"
          },
          "title": "Workstream Ids",
          "type": "array"
        },
        "weeks_low": {
          "description": "Low bound of the phase duration in weeks.",
          "minimum": 0,
          "title": "Weeks Low",
          "type": "number"
        },
        "weeks_high": {
          "description": "High bound of the phase duration in weeks.",
          "minimum": 0,
          "title": "Weeks High",
          "type": "number"
        },
        "milestones": {
          "description": "Milestones in the phase.",
          "items": {
            "$ref": "#/$defs/Milestone"
          },
          "title": "Milestones",
          "type": "array"
        }
      },
      "required": [
        "name",
        "weeks_low",
        "weeks_high"
      ],
      "title": "PhaseEstimate",
      "type": "object"
    },
    "RomRange": {
      "additionalProperties": false,
      "properties": {
        "amount_low": {
          "description": "Low bound of the ROM commercial range.",
          "minimum": 0,
          "title": "Amount Low",
          "type": "number"
        },
        "amount_high": {
          "description": "High bound of the ROM commercial range.",
          "minimum": 0,
          "title": "Amount High",
          "type": "number"
        },
        "currency": {
          "description": "Currency taken from the rate card; empty when no card is selected.",
          "title": "Currency",
          "type": "string"
        },
        "rate_basis": {
          "description": "Blended rate basis used, role mix or explicit.",
          "title": "Rate Basis",
          "type": "string"
        },
        "contingency_pct": {
          "description": "Contingency percentage applied once, for example 15 for 15%.",
          "maximum": 100,
          "minimum": 0,
          "title": "Contingency Pct",
          "type": "number"
        }
      },
      "required": [
        "amount_low",
        "amount_high",
        "currency",
        "rate_basis",
        "contingency_pct"
      ],
      "title": "RomRange",
      "type": "object"
    },
    "TraceEntry": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "What this line computes.",
          "title": "Label",
          "type": "string"
        },
        "formula": {
          "description": "Formula in plain text.",
          "title": "Formula",
          "type": "string"
        },
        "inputs": {
          "description": "Values used in the formula.",
          "items": {
            "$ref": "#/$defs/TraceInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "result": {
          "description": "Result of the formula.",
          "title": "Result",
          "type": "number"
        }
      },
      "required": [
        "label",
        "formula",
        "result"
      ],
      "title": "TraceEntry",
      "type": "object"
    },
    "TraceInput": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Input name used in the formula.",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "description": "Input value as shown to the reviewer.",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "TraceInput",
      "type": "object"
    },
    "WorkstreamEstimate": {
      "additionalProperties": false,
      "properties": {
        "workstream_id": {
          "description": "Workstream id.",
          "title": "Workstream Id",
          "type": "string"
        },
        "name": {
          "description": "Workstream name.",
          "title": "Name",
          "type": "string"
        },
        "req_ids": {
          "description": "Requirements in the workstream.",
          "items": {
            "type": "string"
          },
          "title": "Req Ids",
          "type": "array"
        },
        "roles": {
          "description": "Roles used for the role mix.",
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "complexity": {
          "$ref": "#/$defs/Complexity",
          "description": "Derived complexity of the workstream."
        },
        "effort_low": {
          "description": "Low bound of the effort range in person-weeks.",
          "minimum": 0,
          "title": "Effort Low",
          "type": "number"
        },
        "effort_high": {
          "description": "High bound of the effort range in person-weeks.",
          "minimum": 0,
          "title": "Effort High",
          "type": "number"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel",
          "description": "Confidence in this workstream's estimate."
        },
        "limitations": {
          "description": "What limits the confidence here.",
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "blocked": {
          "default": false,
          "description": "True when the line cannot be calculated.",
          "title": "Blocked",
          "type": "boolean"
        },
        "blocked_reason": {
          "default": "",
          "description": "Why the line is blocked.",
          "title": "Blocked Reason",
          "type": "string"
        },
        "overhead": {
          "default": false,
          "description": "True for discovery, testing and deployment overhead lines.",
          "title": "Overhead",
          "type": "boolean"
        },
        "trace": {
          "description": "Calculation trace.",
          "items": {
            "$ref": "#/$defs/TraceEntry"
          },
          "title": "Trace",
          "type": "array"
        }
      },
      "required": [
        "workstream_id",
        "name",
        "complexity",
        "effort_low",
        "effort_high",
        "confidence"
      ],
      "title": "WorkstreamEstimate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic estimate; every number is reproducible from the trace.",
  "properties": {
    "workstreams": {
      "description": "Workstream lines including overhead lines.",
      "items": {
        "$ref": "#/$defs/WorkstreamEstimate"
      },
      "title": "Workstreams",
      "type": "array"
    },
    "phases": {
      "description": "Delivery phases.",
      "items": {
        "$ref": "#/$defs/PhaseEstimate"
      },
      "title": "Phases",
      "type": "array"
    },
    "effort_low": {
      "description": "Total base effort, low bound, in person-weeks.",
      "minimum": 0,
      "title": "Effort Low",
      "type": "number"
    },
    "effort_high": {
      "description": "Total base effort, high bound, in person-weeks.",
      "minimum": 0,
      "title": "Effort High",
      "type": "number"
    },
    "effort_incl_contingency_low": {
      "description": "Low effort including contingency, shown for information.",
      "minimum": 0,
      "title": "Effort Incl Contingency Low",
      "type": "number"
    },
    "effort_incl_contingency_high": {
      "description": "High effort including contingency, shown for information.",
      "minimum": 0,
      "title": "Effort Incl Contingency High",
      "type": "number"
    },
    "timeline_weeks_low": {
      "description": "Total timeline, low bound, in weeks.",
      "minimum": 0,
      "title": "Timeline Weeks Low",
      "type": "number"
    },
    "timeline_weeks_high": {
      "description": "Total timeline, high bound, in weeks.",
      "minimum": 0,
      "title": "Timeline Weeks High",
      "type": "number"
    },
    "rom": {
      "$ref": "#/$defs/RomRange",
      "description": "ROM commercial range."
    },
    "overall_confidence": {
      "$ref": "#/$defs/ConfidenceLevel",
      "description": "Lowest workstream confidence, reduced."
    },
    "confidence_limitations": {
      "description": "Reasons the overall confidence is not high.",
      "items": {
        "type": "string"
      },
      "title": "Confidence Limitations",
      "type": "array"
    },
    "missing_inputs": {
      "description": "Inputs that are missing and what they affect.",
      "items": {
        "$ref": "#/$defs/MissingInput"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "assumptions": {
      "description": "Every default the calculation used, as plain sentences.",
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "totals_partial": {
      "default": false,
      "description": "True when a blocked line is left out of the totals.",
      "title": "Totals Partial",
      "type": "boolean"
    },
    "blocked_lines": {
      "description": "Lines that cannot be calculated.",
      "items": {
        "$ref": "#/$defs/BlockedLine"
      },
      "title": "Blocked Lines",
      "type": "array"
    },
    "deadline_risk": {
      "default": "",
      "description": "Set when the high timeline exceeds the delivery deadline.",
      "title": "Deadline Risk",
      "type": "string"
    },
    "rate_card_id": {
      "description": "Rate card used.",
      "title": "Rate Card Id",
      "type": "string"
    },
    "config_hash": {
      "description": "Hash of the configuration used.",
      "title": "Config Hash",
      "type": "string"
    },
    "trace": {
      "description": "Session-level trace entries.",
      "items": {
        "$ref": "#/$defs/TraceEntry"
      },
      "title": "Trace",
      "type": "array"
    },
    "calculated_at": {
      "description": "When the estimate was calculated.",
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    }
  },
  "required": [
    "effort_low",
    "effort_high",
    "effort_incl_contingency_low",
    "effort_incl_contingency_high",
    "timeline_weeks_low",
    "timeline_weeks_high",
    "rom",
    "overall_confidence",
    "rate_card_id",
    "config_hash",
    "calculated_at"
  ],
  "title": "Estimate",
  "type": "object"
}
