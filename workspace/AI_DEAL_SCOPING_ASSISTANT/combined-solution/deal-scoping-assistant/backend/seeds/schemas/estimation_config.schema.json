{
  "$defs": {
    "AiProviderPreference": {
      "enum": [
        "platform_native",
        "openai",
        "anthropic",
        "google",
        "open_source",
        "none"
      ],
      "title": "AiProviderPreference",
      "type": "string"
    },
    "BaseEffortEntry": {
      "additionalProperties": false,
      "properties": {
        "unit_type": {
          "$ref": "#/$defs/UnitType",
          "description": "Unit type the base effort applies to."
        },
        "variant": {
          "default": "",
          "description": "Sub-type such as an integration pattern or architecture area.",
          "title": "Variant",
          "type": "string"
        },
        "complexity": {
          "$ref": "#/$defs/Complexity",
          "description": "Complexity level."
        },
        "person_weeks": {
          "description": "Base effort in person-weeks.",
          "minimum": 0,
          "title": "Person Weeks",
          "type": "number"
        }
      },
      "required": [
        "unit_type",
        "complexity",
        "person_weeks"
      ],
      "title": "BaseEffortEntry",
      "type": "object"
    },
    "BlendedRateMode": {
      "enum": [
        "role_mix",
        "explicit"
      ],
      "title": "BlendedRateMode",
      "type": "string"
    },
    "Complexity": {
      "enum": [
        "low",
        "medium",
        "high",
        "very_high"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "ConfidenceSignal": {
      "description": "What the confidence rules look at, all of it input quality.",
      "enum": [
        "assumed_share",
        "open_questions",
        "pending_assumptions",
        "missing_information"
      ],
      "title": "ConfidenceSignal",
      "type": "string"
    },
    "ConfidenceSpread": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel",
          "description": "Confidence level."
        },
        "spread_pct": {
          "description": "Range width applied around the point effort.",
          "minimum": 0,
          "title": "Spread Pct",
          "type": "number"
        }
      },
      "required": [
        "confidence",
        "spread_pct"
      ],
      "title": "ConfidenceSpread",
      "type": "object"
    },
    "ConfidenceThreshold": {
      "additionalProperties": false,
      "properties": {
        "signal": {
          "$ref": "#/$defs/ConfidenceSignal",
          "description": "Input-quality signal being measured."
        },
        "medium_at": {
          "description": "Signal value that drops confidence to medium.",
          "minimum": 0,
          "title": "Medium At",
          "type": "number"
        },
        "low_at": {
          "description": "Signal value that drops confidence to low.",
          "minimum": 0,
          "title": "Low At",
          "type": "number"
        }
      },
      "required": [
        "signal",
        "medium_at",
        "low_at"
      ],
      "title": "ConfidenceThreshold",
      "type": "object"
    },
    "DataMigration": {
      "enum": [
        "none",
        "light",
        "heavy"
      ],
      "title": "DataMigration",
      "type": "string"
    },
    "EstimationRules": {
      "additionalProperties": false,
      "description": "Seeded rule tables from `seeds/config/estimation_defaults.json`.",
      "properties": {
        "base_effort": {
          "description": "Base effort per unit type, variant and complexity.",
          "items": {
            "$ref": "#/$defs/BaseEffortEntry"
          },
          "title": "Base Effort",
          "type": "array"
        },
        "phase_overheads": {
          "description": "Overhead phases as a share of build effort.",
          "items": {
            "$ref": "#/$defs/PhaseOverhead"
          },
          "title": "Phase Overheads",
          "type": "array"
        },
        "factors": {
          "description": "Multipliers for security, testing, environments, migration.",
          "items": {
            "$ref": "#/$defs/FactorEntry"
          },
          "title": "Factors",
          "type": "array"
        },
        "role_mix": {
          "description": "Role mix per workstream type.",
          "items": {
            "$ref": "#/$defs/RoleMixEntry"
          },
          "title": "Role Mix",
          "type": "array"
        },
        "spreads": {
          "description": "Effort range width per confidence level.",
          "items": {
            "$ref": "#/$defs/ConfidenceSpread"
          },
          "title": "Spreads",
          "type": "array"
        },
        "rounding": {
          "description": "Rounding per confidence level.",
          "items": {
            "$ref": "#/$defs/RoundingRule"
          },
          "title": "Rounding",
          "type": "array"
        },
        "factor_scope": {
          "description": "Unit types each factor touches.",
          "items": {
            "$ref": "#/$defs/FactorScope"
          },
          "title": "Factor Scope",
          "type": "array"
        },
        "team_sizes": {
          "description": "Default people in parallel per workstream type.",
          "items": {
            "$ref": "#/$defs/TeamSizeEntry"
          },
          "title": "Team Sizes",
          "type": "array"
        },
        "confidence_thresholds": {
          "description": "Signal values that drop confidence a level.",
          "items": {
            "$ref": "#/$defs/ConfidenceThreshold"
          },
          "title": "Confidence Thresholds",
          "type": "array"
        },
        "low_when_gap_is_critical": {
          "default": true,
          "description": "A critical missing input alone makes a workstream low.",
          "title": "Low When Gap Is Critical",
          "type": "boolean"
        },
        "workstream_types": {
          "description": "Unit kind to workstream type, with the tie-break rank.",
          "items": {
            "$ref": "#/$defs/WorkstreamTypeRule"
          },
          "title": "Workstream Types",
          "type": "array"
        },
        "productivity": {
          "$ref": "#/$defs/ProductivityBounds",
          "description": "Defensible productivity range."
        },
        "reporting": {
          "$ref": "#/$defs/ReportingRules",
          "description": "Decimals kept on reported numbers."
        }
      },
      "title": "EstimationRules",
      "type": "object"
    },
    "FactorEntry": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "$ref": "#/$defs/FactorKind",
          "description": "Which input the multiplier reacts to."
        },
        "value": {
          "description": "Input value the multiplier applies to, e.g. 'regulated'.",
          "title": "Value",
          "type": "string"
        },
        "multiplier": {
          "description": "Multiplier applied to unit effort.",
          "exclusiveMinimum": 0,
          "title": "Multiplier",
          "type": "number"
        }
      },
      "required": [
        "factor",
        "value",
        "multiplier"
      ],
      "title": "FactorEntry",
      "type": "object"
    },
    "FactorKind": {
      "enum": [
        "security_level",
        "testing_level",
        "environments",
        "data_migration"
      ],
      "title": "FactorKind",
      "type": "string"
    },
    "FactorScope": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "$ref": "#/$defs/FactorKind",
          "description": "Factor the scope applies to."
        },
        "unit_types": {
          "description": "Unit types the factor touches; empty means all of them.",
          "items": {
            "$ref": "#/$defs/UnitType"
          },
          "title": "Unit Types",
          "type": "array"
        }
      },
      "required": [
        "factor"
      ],
      "title": "FactorScope",
      "type": "object"
    },
    "PhaseOverhead": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "description": "Overhead workstream or phase name.",
          "title": "Phase",
          "type": "string"
        },
        "pct_of_build": {
          "description": "Share of build effort added by this phase.",
          "minimum": 0,
          "title": "Pct Of Build",
          "type": "number"
        },
        "id": {
          "default": "",
          "description": "Line id for this overhead, e.g. OVH_TESTING.",
          "title": "Id",
          "type": "string"
        },
        "workstream_type": {
          "default": "",
          "description": "Type used to pick the team size and the role mix.",
          "title": "Workstream Type",
          "type": "string"
        },
        "phase_keywords": {
          "description": "Delivery phase names this line belongs to.",
          "items": {
            "type": "string"
          },
          "title": "Phase Keywords",
          "type": "array"
        },
        "before_build": {
          "default": false,
          "description": "Where the line goes when no delivery phase matches: before or after build.",
          "title": "Before Build",
          "type": "boolean"
        }
      },
      "required": [
        "phase",
        "pct_of_build"
      ],
      "title": "PhaseOverhead",
      "type": "object"
    },
    "ProductivityBounds": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "default": 0.5,
          "description": "Lowest defensible productivity factor.",
          "exclusiveMinimum": 0,
          "title": "Min",
          "type": "number"
        },
        "max": {
          "default": 1.2,
          "description": "Highest defensible productivity factor.",
          "exclusiveMinimum": 0,
          "title": "Max",
          "type": "number"
        },
        "default": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0,
          "description": "Factor used when none is given.",
          "title": "Default"
        }
      },
      "title": "ProductivityBounds",
      "type": "object"
    },
    "RateCard": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Rate card id.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Rate card name.",
          "title": "Name",
          "type": "string"
        },
        "currency": {
          "description": "ISO currency code, e.g. USD.",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "rates": {
          "description": "Rate per role.",
          "items": {
            "$ref": "#/$defs/RoleRate"
          },
          "title": "Rates",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "currency"
      ],
      "title": "RateCard",
      "type": "object"
    },
    "ReportingRules": {
      "additionalProperties": false,
      "description": "How many decimals the reported numbers keep, so precision stays supported.",
      "properties": {
        "effort_total_decimals": {
          "default": 0,
          "description": "Decimals on total effort.",
          "minimum": 0,
          "title": "Effort Total Decimals",
          "type": "integer"
        },
        "line_effort_decimals": {
          "default": 2,
          "description": "Decimals on a line's effort.",
          "minimum": 0,
          "title": "Line Effort Decimals",
          "type": "integer"
        },
        "timeline_weeks_decimals": {
          "default": 1,
          "description": "Decimals on weeks.",
          "minimum": 0,
          "title": "Timeline Weeks Decimals",
          "type": "integer"
        }
      },
      "title": "ReportingRules",
      "type": "object"
    },
    "RoleMixEntry": {
      "additionalProperties": false,
      "properties": {
        "workstream_type": {
          "description": "Workstream type the mix applies to.",
          "title": "Workstream Type",
          "type": "string"
        },
        "role": {
          "description": "Role in the mix.",
          "title": "Role",
          "type": "string"
        },
        "share": {
          "description": "Share of the workstream effort for this role.",
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "workstream_type",
        "role",
        "share"
      ],
      "title": "RoleMixEntry",
      "type": "object"
    },
    "RoleRate": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "description": "Role or skill category.",
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "rate_per_person_week": {
          "description": "Rate for one person-week of that role.",
          "minimum": 0,
          "title": "Rate Per Person Week",
          "type": "number"
        }
      },
      "required": [
        "role",
        "rate_per_person_week"
      ],
      "title": "RoleRate",
      "type": "object"
    },
    "RoundingRule": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel",
          "description": "Confidence level."
        },
        "nearest": {
          "description": "Commercial values are rounded to this multiple.",
          "exclusiveMinimum": 0,
          "title": "Nearest",
          "type": "integer"
        }
      },
      "required": [
        "confidence",
        "nearest"
      ],
      "title": "RoundingRule",
      "type": "object"
    },
    "SecurityLevel": {
      "enum": [
        "standard",
        "elevated",
        "regulated"
      ],
      "title": "SecurityLevel",
      "type": "string"
    },
    "SessionConfig": {
      "additionalProperties": false,
      "description": "Estimation and solution inputs held on the session (PLAN sections 2 and 5).",
      "properties": {
        "rate_card_id": {
          "default": "",
          "description": "Selected rate card; it carries the currency.",
          "title": "Rate Card Id",
          "type": "string"
        },
        "rate_overrides": {
          "description": "Per-role rates that replace the card's rate for this session only.",
          "items": {
            "$ref": "#/$defs/RoleRate"
          },
          "title": "Rate Overrides",
          "type": "array"
        },
        "expected_users": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected user volume; missing volume reduces confidence.",
          "title": "Expected Users"
        },
        "target_regions": {
          "description": "Regions the solution must serve.",
          "items": {
            "type": "string"
          },
          "title": "Target Regions",
          "type": "array"
        },
        "delivery_deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required delivery date, when the customer stated one.",
          "title": "Delivery Deadline"
        },
        "security_level": {
          "$ref": "#/$defs/SecurityLevel",
          "default": "standard",
          "description": "Security and compliance level."
        },
        "regulatory_constraints": {
          "description": "Regulations such as GDPR, HIPAA or PCI-DSS.",
          "items": {
            "type": "string"
          },
          "title": "Regulatory Constraints",
          "type": "array"
        },
        "ai_provider_preference": {
          "anyOf": [
            {
              "$ref": "#/$defs/AiProviderPreference"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Customer preference for the AI provider."
        },
        "contingency_pct": {
          "default": 15.0,
          "description": "Contingency percentage applied once to the ROM range, 15 means 15%.",
          "maximum": 100,
          "minimum": 0,
          "title": "Contingency Pct",
          "type": "number"
        },
        "blended_rate_mode": {
          "$ref": "#/$defs/BlendedRateMode",
          "default": "role_mix",
          "description": "How the blended rate is derived."
        },
        "explicit_blended_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Blended rate per person-week when mode is explicit.",
          "title": "Explicit Blended Rate"
        },
        "productivity_factor": {
          "default": 1.0,
          "description": "Productivity assumption used for the timeline.",
          "maximum": 1.2,
          "minimum": 0.5,
          "title": "Productivity Factor",
          "type": "number"
        },
        "working_weeks_per_month": {
          "default": 4.0,
          "description": "Working weeks per month used for timeline reporting.",
          "exclusiveMinimum": 0,
          "title": "Working Weeks Per Month",
          "type": "number"
        },
        "environments_count": {
          "default": 3,
          "description": "Number of environments (dev, test, prod, ...).",
          "minimum": 1,
          "title": "Environments Count",
          "type": "integer"
        },
        "testing_level": {
          "$ref": "#/$defs/TestingLevel",
          "default": "standard",
          "description": "Testing depth required."
        },
        "data_migration": {
          "$ref": "#/$defs/DataMigration",
          "default": "none",
          "description": "Data migration or transformation effort."
        },
        "team_sizes": {
          "description": "Team size overrides per workstream type.",
          "items": {
            "$ref": "#/$defs/TeamSizeEntry"
          },
          "title": "Team Sizes",
          "type": "array"
        }
      },
      "title": "SessionConfig",
      "type": "object"
    },
    "TeamSizeEntry": {
      "additionalProperties": false,
      "properties": {
        "workstream_type": {
          "description": "Workstream type the team size applies to.",
          "title": "Workstream Type",
          "type": "string"
        },
        "team_size": {
          "description": "People working on that workstream in parallel.",
          "exclusiveMinimum": 0,
          "title": "Team Size",
          "type": "number"
        }
      },
      "required": [
        "workstream_type",
        "team_size"
      ],
      "title": "TeamSizeEntry",
      "type": "object"
    },
    "TestingLevel": {
      "enum": [
        "standard",
        "extended"
      ],
      "title": "TestingLevel",
      "type": "string"
    },
    "UnitType": {
      "enum": [
        "capability",
        "integration",
        "ai_use_case",
        "architecture_component",
        "data_domain"
      ],
      "title": "UnitType",
      "type": "string"
    },
    "WorkstreamTypeRule": {
      "additionalProperties": false,
      "properties": {
        "unit_type": {
          "$ref": "#/$defs/UnitType",
          "description": "Unit kind found in the workstream."
        },
        "workstream_type": {
          "description": "Type the workstream takes when this kind dominates.",
          "title": "Workstream Type",
          "type": "string"
        },
        "tie_break_rank": {
          "description": "Lower rank wins when two kinds tie.",
          "minimum": 0,
          "title": "Tie Break Rank",
          "type": "integer"
        }
      },
      "required": [
        "unit_type",
        "workstream_type",
        "tie_break_rank"
      ],
      "title": "WorkstreamTypeRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the engine needs: session inputs, the rate card and the rule tables.",
  "properties": {
    "session_config": {
      "$ref": "#/$defs/SessionConfig",
      "description": "Per-session estimation inputs."
    },
    "rate_card": {
      "anyOf": [
        {
          "$ref": "#/$defs/RateCard"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rate card for the session; None means no card is selected."
    },
    "team_sizes": {
      "description": "Team size per workstream type: seeded defaults with the session overrides.",
      "items": {
        "$ref": "#/$defs/TeamSizeEntry"
      },
      "title": "Team Sizes",
      "type": "array"
    },
    "rules": {
      "$ref": "#/$defs/EstimationRules",
      "description": "Seeded rule tables."
    }
  },
  "required": [
    "session_config",
    "rules"
  ],
  "title": "EstimationConfig",
  "type": "object"
}
