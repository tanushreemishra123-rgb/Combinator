{
  "$defs": {
    "DocumentFormat": {
      "enum": [
        "txt",
        "md",
        "pdf",
        "docx"
      ],
      "title": "DocumentFormat",
      "type": "string"
    },
    "DocumentKind": {
      "enum": [
        "pasted",
        "uploaded"
      ],
      "title": "DocumentKind",
      "type": "string"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "description": "Stable segment id, for example D1.S12.",
          "title": "Segment Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SegmentKind",
          "description": "Segment granularity: page, heading or paragraph."
        },
        "index": {
          "description": "Position of the segment within the document.",
          "title": "Index",
          "type": "integer"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page number for PDF sources.",
          "title": "Page"
        },
        "heading": {
          "default": "",
          "description": "Nearest heading text, when known.",
          "title": "Heading",
          "type": "string"
        },
        "text": {
          "description": "Normalized text of the segment.",
          "title": "Text",
          "type": "string"
        },
        "start": {
          "description": "Start offset in the normalized document text.",
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "End offset in the normalized document text.",
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "segment_id",
        "kind",
        "index",
        "text",
        "start",
        "end"
      ],
      "title": "Segment",
      "type": "object"
    },
    "SegmentKind": {
      "enum": [
        "page",
        "heading",
        "paragraph"
      ],
      "title": "SegmentKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Document id.",
      "title": "Id",
      "type": "string"
    },
    "session_id": {
      "description": "Owning session id.",
      "title": "Session Id",
      "type": "string"
    },
    "name": {
      "description": "File name or a label for pasted text.",
      "title": "Name",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/DocumentKind",
      "description": "Whether the text was pasted or uploaded."
    },
    "format": {
      "$ref": "#/$defs/DocumentFormat",
      "description": "Source format of the document."
    },
    "normalized_text": {
      "description": "Plain text extracted from the source.",
      "title": "Normalized Text",
      "type": "string"
    },
    "segments": {
      "description": "Addressable text segments.",
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    },
    "created_at": {
      "description": "Creation timestamp.",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "session_id",
    "name",
    "kind",
    "format",
    "normalized_text",
    "created_at"
  ],
  "title": "SourceDocument",
  "type": "object"
}
