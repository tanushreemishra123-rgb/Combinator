APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=10
MAX_INPUT_CHARS=60000

# mock needs no key. live needs AI_MODE, AI_PROVIDER, AI_MODEL and the matching key.
# The documented live setup is Google Gemini: its free tier has room for a whole stage
# in one call. Alternatives: AI_PROVIDER=groq (a key with a small per-minute token limit
# will not fit a stage) or AI_PROVIDER=ollama with a local model.
AI_MODE=mock
AI_PROVIDER=google_genai
# a Gemini Flash model id your key lists in Google AI Studio, for example gemini-3.8-flash
AI_MODEL=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=120
AI_MAX_REPAIR_ATTEMPTS=2
# Optional. Empty means the provider's own default. A whole stage is one answer, so the
# largest seeded scenario needs about 10,000 output tokens for the extraction stage.
AI_MAX_OUTPUT_TOKENS=16384
# groq only: low, medium or high. Empty means the provider default.
AI_REASONING_EFFORT=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
