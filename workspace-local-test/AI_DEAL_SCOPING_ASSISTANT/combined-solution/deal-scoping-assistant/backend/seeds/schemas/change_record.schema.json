{
  "$defs": {
    "AiProviderPreference": {
      "enum": [
        "platform_native",
        "openai",
        "anthropic",
        "google",
        "open_source",
        "none"
      ],
      "title": "AiProviderPreference",
      "type": "string"
    },
    "AnswerStatus": {
      "enum": [
        "open",
        "answered",
        "dismissed"
      ],
      "title": "AnswerStatus",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "prd",
        "functional_scope",
        "platform_recommendation",
        "architecture",
        "data_strategy",
        "integration_architecture",
        "ai_strategy",
        "estimate_drivers",
        "estimate",
        "executive_summary"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "AssumptionDetails": {
      "additionalProperties": false,
      "properties": {
        "requires_confirmation": {
          "default": true,
          "description": "True when the customer must confirm this assumption.",
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "confirmation_status": {
          "$ref": "#/$defs/ConfirmationStatus",
          "default": "pending",
          "description": "Confirmation state of the assumption."
        },
        "impact_if_wrong": {
          "default": "",
          "description": "What changes in the solution if the assumption is wrong.",
          "title": "Impact If Wrong",
          "type": "string"
        }
      },
      "title": "AssumptionDetails",
      "type": "object"
    },
    "BlendedRateMode": {
      "enum": [
        "role_mix",
        "explicit"
      ],
      "title": "BlendedRateMode",
      "type": "string"
    },
    "ChangeRequest": {
      "additionalProperties": false,
      "description": "The change the reviewer asks for: what kind, and the new value it carries.",
      "properties": {
        "change_type": {
          "$ref": "#/$defs/ChangeType",
          "description": "What kind of change the user made."
        },
        "description": {
          "default": "",
          "description": "Human-readable description of the change.",
          "title": "Description",
          "type": "string"
        },
        "item_ids": {
          "description": "Scope item or unit ids affected by the change.",
          "items": {
            "type": "string"
          },
          "title": "Item Ids",
          "type": "array"
        },
        "values": {
          "description": "Changed fields with old and new values; filled in when the change is applied.",
          "items": {
            "$ref": "#/$defs/ChangeValue"
          },
          "title": "Values",
          "type": "array"
        },
        "item_update": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeItemUpdate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New field values for an edit, priority or status change."
        },
        "item_create": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeItemCreate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The item to add, for a scope_item_added change."
        },
        "answer": {
          "default": "",
          "description": "Answer recorded for a question.",
          "title": "Answer",
          "type": "string"
        },
        "confirmed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True confirms an assumption, false rejects it.",
          "title": "Confirmed"
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The full new session config, for a config change."
        },
        "cloud_platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/CloudPlatform"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New cloud platform; only read when platform_change is true."
        },
        "platform_change": {
          "default": false,
          "description": "True when cloud_platform is part of the change; it may be set to null.",
          "title": "Platform Change",
          "type": "boolean"
        },
        "unit_complexity": {
          "description": "Per-unit complexity overrides for the estimate.",
          "items": {
            "$ref": "#/$defs/UnitComplexityOverride"
          },
          "title": "Unit Complexity",
          "type": "array"
        }
      },
      "required": [
        "change_type"
      ],
      "title": "ChangeRequest",
      "type": "object"
    },
    "ChangeType": {
      "enum": [
        "scope_item_edit",
        "scope_item_priority",
        "scope_item_status",
        "scope_item_added",
        "scope_item_removed",
        "assumption_decision",
        "question_answered",
        "config_change",
        "unit_complexity"
      ],
      "title": "ChangeType",
      "type": "string"
    },
    "ChangeValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Field or config key that changed.",
          "title": "Key",
          "type": "string"
        },
        "old_value": {
          "description": "Value before the change, as text.",
          "title": "Old Value",
          "type": "string"
        },
        "new_value": {
          "description": "Value after the change, as text.",
          "title": "New Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "old_value",
        "new_value"
      ],
      "title": "ChangeValue",
      "type": "object"
    },
    "CloudPlatform": {
      "enum": [
        "aws",
        "azure",
        "gcp"
      ],
      "title": "CloudPlatform",
      "type": "string"
    },
    "Complexity": {
      "enum": [
        "low",
        "medium",
        "high",
        "very_high"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "ConfirmationStatus": {
      "enum": [
        "pending",
        "confirmed",
        "rejected"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "DataMigration": {
      "enum": [
        "none",
        "light",
        "heavy"
      ],
      "title": "DataMigration",
      "type": "string"
    },
    "GapCriticality": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "GapCriticality",
      "type": "string"
    },
    "GapDetails": {
      "additionalProperties": false,
      "properties": {
        "criticality": {
          "$ref": "#/$defs/GapCriticality",
          "description": "How critical the missing information is."
        },
        "impacted_areas": {
          "description": "Areas affected by the missing information.",
          "items": {
            "type": "string"
          },
          "title": "Impacted Areas",
          "type": "array"
        },
        "question_id": {
          "default": "",
          "description": "Clarification question raised for this gap, if any.",
          "title": "Question Id",
          "type": "string"
        },
        "assumption_id": {
          "default": "",
          "description": "Assumption made for this gap, if any.",
          "title": "Assumption Id",
          "type": "string"
        }
      },
      "required": [
        "criticality"
      ],
      "title": "GapDetails",
      "type": "object"
    },
    "ImpactAction": {
      "description": "What has to happen to the affected output.",
      "enum": [
        "regenerate",
        "recalculate",
        "relink"
      ],
      "title": "ImpactAction",
      "type": "string"
    },
    "ImpactEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactKind",
          "description": "Artifact affected by the change."
        },
        "element_ids": {
          "description": "Elements inside the artifact that are affected.",
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "reason": {
          "description": "Why these elements are affected.",
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ImpactAction",
          "default": "regenerate",
          "description": "regenerate, recalculate or relink."
        }
      },
      "required": [
        "artifact",
        "reason"
      ],
      "title": "ImpactEntry",
      "type": "object"
    },
    "IntegrationDetails": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "description": "External or internal system involved.",
          "title": "System",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/IntegrationDirection",
          "description": "Direction of the information flow."
        },
        "pattern": {
          "$ref": "#/$defs/IntegrationPattern",
          "description": "Integration pattern: api, event, batch, file."
        }
      },
      "required": [
        "system",
        "direction",
        "pattern"
      ],
      "title": "IntegrationDetails",
      "type": "object"
    },
    "IntegrationDirection": {
      "enum": [
        "inbound",
        "outbound",
        "bidirectional"
      ],
      "title": "IntegrationDirection",
      "type": "string"
    },
    "IntegrationPattern": {
      "enum": [
        "api",
        "event",
        "batch",
        "file"
      ],
      "title": "IntegrationPattern",
      "type": "string"
    },
    "ItemStatus": {
      "enum": [
        "proposed",
        "approved",
        "modified",
        "rejected"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "ItemType": {
      "description": "The 15 scope categories; the value doubles as the id prefix (FR_01, NFR_02, ...).",
      "enum": [
        "BR",
        "PER",
        "FR",
        "NFR",
        "SYS",
        "INT",
        "DATA",
        "SEC",
        "TECH",
        "CON",
        "DEP",
        "RISK",
        "GAP",
        "ASM",
        "Q"
      ],
      "title": "ItemType",
      "type": "string"
    },
    "NfrCategory": {
      "enum": [
        "performance",
        "scalability",
        "availability",
        "security",
        "compliance",
        "usability",
        "maintainability",
        "observability"
      ],
      "title": "NfrCategory",
      "type": "string"
    },
    "NfrDetails": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/NfrCategory",
          "description": "Non-functional requirement category."
        }
      },
      "required": [
        "category"
      ],
      "title": "NfrDetails",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "customer_stated",
        "ai_inferred",
        "assumed"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "must",
        "high",
        "medium",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "QuestionDetails": {
      "additionalProperties": false,
      "properties": {
        "why_it_matters": {
          "default": "",
          "description": "Why the answer changes the solution.",
          "title": "Why It Matters",
          "type": "string"
        },
        "affected_ids": {
          "description": "Scope item ids that depend on the answer.",
          "items": {
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "answer_status": {
          "$ref": "#/$defs/AnswerStatus",
          "default": "open",
          "description": "Whether the question is open, answered or dismissed."
        },
        "answer": {
          "default": "",
          "description": "Answer recorded by the reviewer.",
          "title": "Answer",
          "type": "string"
        }
      },
      "title": "QuestionDetails",
      "type": "object"
    },
    "RoleRate": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "description": "Role or skill category.",
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "rate_per_person_week": {
          "description": "Rate for one person-week of that role.",
          "minimum": 0,
          "title": "Rate Per Person Week",
          "type": "number"
        }
      },
      "required": [
        "role",
        "rate_per_person_week"
      ],
      "title": "RoleRate",
      "type": "object"
    },
    "ScopeItemCreate": {
      "additionalProperties": false,
      "description": "User-created item; the id is assigned by the server from the type prefix.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ItemType",
          "description": "Scope category; also the id prefix."
        },
        "title": {
          "description": "Short title of the item.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Full statement of the item.",
          "title": "Description",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "medium",
          "description": "Review priority."
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "customer_stated, ai_inferred or assumed."
        },
        "source_refs": {
          "description": "References to the originating customer text.",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "related_ids": {
          "description": "Related scope item ids (dependencies, questions).",
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "tags": {
          "description": "Tags used by change-impact rules, e.g. scalability.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "notes": {
          "default": "",
          "description": "Reviewer notes.",
          "title": "Notes",
          "type": "string"
        },
        "absence_note": {
          "default": "",
          "description": "Why there is no source reference, for GAP and Q items.",
          "title": "Absence Note",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/ScopeItemDetails",
          "description": "Type-specific fields."
        }
      },
      "required": [
        "type",
        "title",
        "origin"
      ],
      "title": "ScopeItemCreate",
      "type": "object"
    },
    "ScopeItemDetails": {
      "additionalProperties": false,
      "description": "Type-specific fields; exactly one block is filled, matching the item type.",
      "properties": {
        "nfr": {
          "anyOf": [
            {
              "$ref": "#/$defs/NfrDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Details for NFR items."
        },
        "integration": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Details for INT items."
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/GapDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Details for GAP items."
        },
        "assumption": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssumptionDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Details for ASM items."
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Details for Q items."
        }
      },
      "title": "ScopeItemDetails",
      "type": "object"
    },
    "ScopeItemUpdate": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SourceRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Refs"
        },
        "related_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Ids"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "absence_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absence Note"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeItemDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ScopeItemUpdate",
      "type": "object"
    },
    "SecurityLevel": {
      "enum": [
        "standard",
        "elevated",
        "regulated"
      ],
      "title": "SecurityLevel",
      "type": "string"
    },
    "SessionConfig": {
      "additionalProperties": false,
      "description": "Estimation and solution inputs held on the session (PLAN sections 2 and 5).",
      "properties": {
        "rate_card_id": {
          "default": "",
          "description": "Selected rate card; it carries the currency.",
          "title": "Rate Card Id",
          "type": "string"
        },
        "rate_overrides": {
          "description": "Per-role rates that replace the card's rate for this session only.",
          "items": {
            "$ref": "#/$defs/RoleRate"
          },
          "title": "Rate Overrides",
          "type": "array"
        },
        "expected_users": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected user volume; missing volume reduces confidence.",
          "title": "Expected Users"
        },
        "target_regions": {
          "description": "Regions the solution must serve.",
          "items": {
            "type": "string"
          },
          "title": "Target Regions",
          "type": "array"
        },
        "delivery_deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required delivery date, when the customer stated one.",
          "title": "Delivery Deadline"
        },
        "security_level": {
          "$ref": "#/$defs/SecurityLevel",
          "default": "standard",
          "description": "Security and compliance level."
        },
        "regulatory_constraints": {
          "description": "Regulations such as GDPR, HIPAA or PCI-DSS.",
          "items": {
            "type": "string"
          },
          "title": "Regulatory Constraints",
          "type": "array"
        },
        "ai_provider_preference": {
          "anyOf": [
            {
              "$ref": "#/$defs/AiProviderPreference"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Customer preference for the AI provider."
        },
        "contingency_pct": {
          "default": 15.0,
          "description": "Contingency percentage applied once to the ROM range, 15 means 15%.",
          "maximum": 100,
          "minimum": 0,
          "title": "Contingency Pct",
          "type": "number"
        },
        "blended_rate_mode": {
          "$ref": "#/$defs/BlendedRateMode",
          "default": "role_mix",
          "description": "How the blended rate is derived."
        },
        "explicit_blended_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Blended rate per person-week when mode is explicit.",
          "title": "Explicit Blended Rate"
        },
        "productivity_factor": {
          "default": 1.0,
          "description": "Productivity assumption used for the timeline.",
          "maximum": 1.2,
          "minimum": 0.5,
          "title": "Productivity Factor",
          "type": "number"
        },
        "working_weeks_per_month": {
          "default": 4.0,
          "description": "Working weeks per month used for timeline reporting.",
          "exclusiveMinimum": 0,
          "title": "Working Weeks Per Month",
          "type": "number"
        },
        "environments_count": {
          "default": 3,
          "description": "Number of environments (dev, test, prod, ...).",
          "minimum": 1,
          "title": "Environments Count",
          "type": "integer"
        },
        "testing_level": {
          "$ref": "#/$defs/TestingLevel",
          "default": "standard",
          "description": "Testing depth required."
        },
        "data_migration": {
          "$ref": "#/$defs/DataMigration",
          "default": "none",
          "description": "Data migration or transformation effort."
        },
        "team_sizes": {
          "description": "Team size overrides per workstream type.",
          "items": {
            "$ref": "#/$defs/TeamSizeEntry"
          },
          "title": "Team Sizes",
          "type": "array"
        }
      },
      "title": "SessionConfig",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "description": "Id of the source document the text came from.",
          "title": "Document Id",
          "type": "string"
        },
        "segment_id": {
          "description": "Segment id inside that document, for example D1.S12.",
          "title": "Segment Id",
          "type": "string"
        },
        "quote": {
          "description": "Exact customer text this item was taken from.",
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "default": 0,
          "description": "Start offset of the quote in the document.",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "default": 0,
          "description": "End offset of the quote in the document.",
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "verified": {
          "default": false,
          "description": "True when the quote was matched against the segment text.",
          "title": "Verified",
          "type": "boolean"
