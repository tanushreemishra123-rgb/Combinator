# Optional: the app runs fully in deterministic mock mode without any key.
# Set ONE of the keys below to enable a live model provider (it falls back to
# mock automatically if the provider is unavailable).

# Groq - free tier. Key: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=

# Google Gemini - free tier. Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional overrides.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_TIMEOUT_S=30     # per-call budget, shared by every live provider
# LLM_PROVIDER=gemini   # groq | gemini - pick the primary when both keys are set
#                       # (unset: first configured, in the order groq → gemini)
# PUZZLE_FORCE_MOCK=1   # pin deterministic mock mode even when a key is present
