{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "prd",
        "functional_scope",
        "platform_recommendation",
        "architecture",
        "data_strategy",
        "integration_architecture",
        "ai_strategy",
        "estimate_drivers",
        "estimate",
        "executive_summary"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactStatus": {
      "enum": [
        "fresh",
        "stale"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "API view of a stored artifact; `content` holds the model for `kind`.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ArtifactKind",
      "description": "Artifact kind."
    },
    "version": {
      "description": "Version, incremented on every regeneration.",
      "title": "Version",
      "type": "integer"
    },
    "scope_version_used": {
      "description": "Scope version the artifact was generated from.",
      "title": "Scope Version Used",
      "type": "integer"
    },
    "config_hash_used": {
      "description": "Hash of the session config used.",
      "title": "Config Hash Used",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ArtifactStatus",
      "description": "fresh or stale."
    },
    "stale_reasons": {
      "description": "Why the artifact is stale, when it is.",
      "items": {
        "type": "string"
      },
      "title": "Stale Reasons",
      "type": "array"
    },
    "generated_by": {
      "description": "mock:recorded or live:<provider>/<model>.",
      "title": "Generated By",
      "type": "string"
    },
    "created_at": {
      "description": "When this version was generated.",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "content": {
      "additionalProperties": true,
      "description": "Validated content of the artifact kind.",
      "title": "Content",
      "type": "object"
    }
  },
  "required": [
    "kind",
    "version",
    "scope_version_used",
    "config_hash_used",
    "status",
    "generated_by",
    "created_at",
    "content"
  ],
  "title": "ArtifactEnvelope",
  "type": "object"
}
