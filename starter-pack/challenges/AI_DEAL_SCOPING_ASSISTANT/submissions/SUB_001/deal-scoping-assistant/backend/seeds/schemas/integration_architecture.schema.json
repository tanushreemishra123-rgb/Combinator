{
  "$defs": {
    "Basis": {
      "enum": [
        "customer",
        "inferred",
        "assumed",
        "recommended"
      ],
      "title": "Basis",
      "type": "string"
    },
    "Flow": {
      "additionalProperties": false,
      "properties": {
        "from_id": {
          "description": "Id or name of the source component or system.",
          "title": "From Id",
          "type": "string"
        },
        "to_id": {
          "description": "Id or name of the target component or system.",
          "title": "To Id",
          "type": "string"
        },
        "label": {
          "description": "What moves between them.",
          "title": "Label",
          "type": "string"
        },
        "protocol": {
          "default": "",
          "description": "Protocol or mechanism, for example HTTPS REST.",
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "from_id",
        "to_id",
        "label"
      ],
      "title": "Flow",
      "type": "object"
    },
    "IntegrationDirection": {
      "enum": [
        "inbound",
        "outbound",
        "bidirectional"
      ],
      "title": "IntegrationDirection",
      "type": "string"
    },
    "IntegrationItem": {
      "additionalProperties": false,
      "properties": {
        "req_ids": {
          "description": "Scope item ids this element is grounded in.",
          "items": {
            "type": "string"
          },
          "title": "Req Ids",
          "type": "array"
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "description": "customer, inferred, assumed or recommended."
        },
        "validation_required": {
          "default": false,
          "description": "True when a human must validate this element before use.",
          "title": "Validation Required",
          "type": "boolean"
        },
        "validation_reason": {
          "default": "",
          "description": "Why human validation is required, when it is.",
          "title": "Validation Reason",
          "type": "string"
        },
        "id": {
          "description": "Integration id such as IA_01.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Integration name.",
          "title": "Name",
          "type": "string"
        },
        "source_system": {
          "description": "System the information comes from.",
          "title": "Source System",
          "type": "string"
        },
        "target_system": {
          "description": "System the information goes to.",
          "title": "Target System",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/IntegrationDirection",
          "description": "Direction of the flow."
        },
        "pattern": {
          "$ref": "#/$defs/IntegrationPattern",
          "description": "api, event, batch or file."
        },
        "auth_approach": {
          "description": "Authentication approach.",
          "title": "Auth Approach",
          "type": "string"
        },
        "error_handling": {
          "description": "Error handling approach.",
          "title": "Error Handling",
          "type": "string"
        },
        "retry_behavior": {
          "description": "Retry behaviour.",
          "title": "Retry Behavior",
          "type": "string"
        },
        "monitoring": {
          "description": "How the integration is monitored.",
          "title": "Monitoring",
          "type": "string"
        },
        "sync_considerations": {
          "description": "Data synchronization considerations.",
          "title": "Sync Considerations",
          "type": "string"
        },
        "arc_ids": {
          "description": "Architecture component ids involved.",
          "items": {
            "type": "string"
          },
          "title": "Arc Ids",
          "type": "array"
        }
      },
      "required": [
        "basis",
        "id",
        "name",
        "source_system",
        "target_system",
        "direction",
        "pattern",
        "auth_approach",
        "error_handling",
        "retry_behavior",
        "monitoring",
        "sync_considerations"
      ],
      "title": "IntegrationItem",
      "type": "object"
    },
    "IntegrationPattern": {
      "enum": [
        "api",
        "event",
        "batch",
        "file"
      ],
      "title": "IntegrationPattern",
      "type": "string"
    },
    "SystemRef": {
      "additionalProperties": false,
      "properties": {
        "req_ids": {
          "description": "Scope item ids this element is grounded in.",
          "items": {
            "type": "string"
          },
          "title": "Req Ids",
          "type": "array"
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "description": "customer, inferred, assumed or recommended."
        },
        "validation_required": {
          "default": false,
          "description": "True when a human must validate this element before use.",
          "title": "Validation Required",
          "type": "boolean"
        },
        "validation_reason": {
          "default": "",
          "description": "Why human validation is required, when it is.",
          "title": "Validation Reason",
          "type": "string"
        },
        "name": {
          "description": "System name.",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Role of the system in the solution.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "name"
      ],
      "title": "SystemRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "integrations": {
      "description": "Planned integrations.",
      "items": {
        "$ref": "#/$defs/IntegrationItem"
      },
      "title": "Integrations",
      "type": "array"
    },
    "internal_systems": {
      "description": "Internal systems involved.",
      "items": {
        "$ref": "#/$defs/SystemRef"
      },
      "title": "Internal Systems",
      "type": "array"
    },
    "external_systems": {
      "description": "External systems involved.",
      "items": {
        "$ref": "#/$defs/SystemRef"
      },
      "title": "External Systems",
      "type": "array"
    },
    "flows": {
      "description": "How information moves between systems and components.",
      "items": {
        "$ref": "#/$defs/Flow"
      },
      "title": "Flows",
      "type": "array"
    }
  },
  "title": "IntegrationArchitecture",
  "type": "object"
}
