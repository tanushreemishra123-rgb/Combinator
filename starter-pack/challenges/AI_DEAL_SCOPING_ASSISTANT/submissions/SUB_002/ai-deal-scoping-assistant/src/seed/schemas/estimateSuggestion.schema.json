{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workstreams": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "phaseId": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "drivers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "capability",
                    "integration",
                    "data",
                    "ai",
                    "security",
                    "infrastructure",
                    "nonFunctional"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "complexity": {
                  "type": "string",
                  "enum": [
                    "Low",
                    "Medium",
                    "High",
                    "Very High"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "refIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "type",
                "label",
                "complexity",
                "rationale",
                "refIds"
              ],
              "additionalProperties": false
            }
          },
          "skills": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "phaseId",
          "requirementIds",
          "drivers",
          "skills"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "exclusions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "workstreams",
    "risks",
    "dependencies",
    "assumptions",
    "exclusions",
    "explanation"
  ],
  "additionalProperties": false
}
