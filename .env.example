# ─────────────────────────────────────────────────────────────────────────────
# Topcoder Combinator — configuration (all optional; mock mode needs nothing)
# Copy to `.env`. Never commit a real `.env`. No secret is ever written to a
# workspace, log, or client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Provider selection: mock | openai | bedrock   (default: mock)
# Mock is fully deterministic and needs no network or key — use it for review.
COMBINATOR_LLM_PROVIDER=mock

# Shared generation controls (apply to every provider)
COMBINATOR_LLM_TEMPERATURE=0
COMBINATOR_LLM_MAX_TOKENS=1200
COMBINATOR_LLM_TIMEOUT_MS=60000
COMBINATOR_LLM_MAX_RETRIES=2

# ── OpenAI (default live provider) ───────────────────────────────────────────
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: override the OpenAI-compatible endpoint (leave unset for the default).
# OPENAI_BASE_URL=

# ── Amazon Bedrock (usable via config only; no code change required) ──────────
# AWS credentials come from the standard AWS chain (env, shared config, role).
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Approximate cost model (USD per 1K tokens) for the usage report ───────────
# Override to match your contract; used only for the reported cost estimate.
COMBINATOR_COST_PER_1K_INPUT=0.00015
COMBINATOR_COST_PER_1K_OUTPUT=0.0006

# ── Review UI ────────────────────────────────────────────────────────────────
COMBINATOR_UI_PORT=4600
